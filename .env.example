# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored; this template is not.
# ---------------------------------------------------------------------------

# ---- Server -----------------------------------------------------------------

# Port the Express server listens on. Defaults to 3000.
PORT=3000

# Required by POST /say-hello and POST /DeletePlayerDataByPlayerId.
# The browser must send the same value in the `x-admin-api-key` header —
# paste it into the admin page's "Admin API Key" panel.
ADMIN_API_KEY=

# ---- Unity Cloud Code -------------------------------------------------------

# Project and environment the Cloud Code module lives in.
UNITY_PROJECT_ID=
UNITY_ENVIRONMENT_ID=

# Service account credentials (Unity Dashboard > Project > Service Accounts).
UNITY_SERVICE_ACCOUNT_KEY_ID=
UNITY_SERVICE_ACCOUNT_SECRET_KEY=

# Cloud Code module that holds SayHello / DeletePlayerDataByPlayerId.
# Defaults to DuyAnhTodCloud2 when unset.
UNITY_CLOUD_CODE_MODULE=DuyAnhTodCloud2

# ---- Scam-detection AI backend (optional) -----------------------------------

# Documented in .env but not currently read by server.js: POST /ai still
# returns the built-in stub reply. Set this when the /ai handler is wired up.
SCAM_API_URL=
SCAM_API_KEY_HEADER=x-api-key
SCAM_API_KEY=

# Optional fallback X-User-ID (a valid UUID) used when the browser does not
# send one.
SCAM_USER_ID=
